[0.017, "o", "Terminal session recorder, streamer, and player\r\n\r\n\u001b[1m\u001b[4mUsage:\u001b[0m \u001b[1masciinema\u001b[0m [OPTIONS] <COMMAND>\r\n\r\n\u001b[1m\u001b[4mCommands:\u001b[0m\r\n  \u001b[1mrecord\u001b[0m   Record a terminal session [aliases: rec]\r\n  \u001b[1mstream\u001b[0m   Stream a terminal session\r\n  \u001b[1msession\u001b[0m  Record and stream a terminal session\r\n  \u001b[1mplay\u001b[0m     Play back a terminal session\r\n  \u001b[1mupload\u001b[0m   Upload a recording to an asciinema server\r\n  \u001b[1mauth\u001b[0m     Authenticate this CLI with an asciinema server account\r\n  \u001b[1mcat\u001b[0m      Concatenate multiple recordings\r\n  \u001b[1mconvert\u001b[0m  Convert a recording to another format\r\n  \u001b[1mhelp\u001b[0m     Print this message or the help of the given subcommand(s)\r\n\r\n\u001b[1m\u001b[4mOptions:\u001b[0m\r\n  \u001b[1m-q\u001b[0m, \u001b[1m--quiet\u001b[0m\r\n          Suppress diagnostic messages and progress indicators. Only error messages\r\n          will be displayed.\r\n\r\n  \u001b[1m-h\u001b[0m, \u001b[1m--help\u001b[0m\r\n          Print help (see a summary with '-h')\r\n\r\n  \u001b[1m-V\u001b[0m, \u001b[1m--version\u001b[0m\r\n          Print version\r\n"]
